# Copy to .env (local) and/or .env.modal (Modal Secret source; both gitignored):
#   cp .env.example .env
#   cp .env.example .env.modal
#   modal secret create skoka-dev --from-dotenv .env.modal

# Hugging Face token with access to gated facebook/sam3
HF_TOKEN=

# Device selection: auto | cuda | mps | cpu
# auto resolves as CUDA → MPS → CPU
# Modal workers force cuda via image env.
INFERENCE_DEVICE=auto

# Model dtype: auto | float16 | float32 | bfloat16
# auto uses float16 on CUDA/MPS and float32 on CPU
SAM3_DTYPE=auto

# Optional model / threshold overrides
SAM3_MODEL_ID=facebook/sam3
SAM3_SCORE_THRESHOLD=0.35
SAM3_MASK_THRESHOLD=0.5

# Set to 1 to allow optional integration tests (still needs HF_TOKEN)
# INFERENCE_RUN_INTEGRATION=1

# --- Cloudflare R2 (S3-compatible; private bucket) ---
# Endpoint may be omitted if R2_ACCOUNT_ID is set
# (defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- NestJS callback auth (shared with API in Phase 4) ---
# HMAC + Bearer; never commit a real value.
CALLBACK_SHARED_SECRET=
# CALLBACK_TIMEOUT_SECONDS=10
# CALLBACK_MAX_RETRIES=3

# Optional: set to 1 to run live R2 storage tests (needs R2_* above)
# INFERENCE_RUN_R2_INTEGRATION=1
