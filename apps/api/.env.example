# Copy to apps/api/.env (gitignored). Placeholders only — never commit secrets.
#   cp .env.example .env

NODE_ENV=development
PORT=3000

# When true, Nest boots with TypeORM migrationsRun and Docker entrypoint runs CLI migrations.
RUN_MIGRATIONS=true

# Public HTTPS origin of this API (no path). Used as Modal callbackUrl.
# Local: ngrok/cloudflared URL. Production: Render URL.
PUBLIC_BASE_URL=

# --- Postgres (local Compose defaults) ---
# Prefer discrete fields locally. For Supabase prod, set DATABASE_URL + DATABASE_SSL=true.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=skoka
DATABASE_PASSWORD=skoka
DATABASE_NAME=skoka
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Supabase (production / staging):
# Prefer session pooler (port 5432) over direct db.*.supabase.co on IPv4-only networks.
# User format for pooler: postgres.<project-ref>
# DATABASE_HOST=aws-0-<region>.pooler.supabase.com
# DATABASE_PORT=5432
# DATABASE_USER=postgres.<project-ref>
# DATABASE_PASSWORD=
# DATABASE_NAME=postgres
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5
# Or: DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Cloudflare R2 (same private bucket as services/inference; no MinIO) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Uploads ---
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp

# Job processing deadline (hours); keep below R2 ~24h object lifecycle.
JOB_DEADLINE_HOURS=12
JOB_MAX_ATTEMPTS=3
# Lease while Modal runs (Modal timeout is 600s); default 12 minutes.
JOB_LEASE_MS=720000
JOB_RETRY_BACKOFF_MS=15000

# In-process loops (disable in unit/e2e if needed).
DISPATCHER_ENABLED=true
DISPATCHER_POLL_MS=2000
DISPATCHER_MAX_CONCURRENT=2
RECOVERY_ENABLED=true
RECOVERY_POLL_MS=10000

# Shared with Modal secret skoka-dev (callback Bearer + HMAC). Same name as inference.
CALLBACK_SHARED_SECRET=
CALLBACK_MAX_SKEW_SECONDS=300

# Modal JS SDK — optional when ~/.modal.toml exists on the host.
# Required in Docker/Render: set both from `modal token new` / dashboard.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=skoka-inference
MODAL_FUNCTION_NAME=run_job

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Random secret; pass the same value as secret_token when calling setWebhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_PROMPT=person
